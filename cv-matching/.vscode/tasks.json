{
  "version": "2.0.0",
  "tasks": [
    { "label": "1. Préparer les offres", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/prepare_data.py", "problemMatcher": [] },
    { "label": "2. Calculer les embeddings", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/build_artifacts.py", "problemMatcher": [] },
    { "label": "3. CV fictifs de démo", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/make_demo_cvs.py", "problemMatcher": [] },
    { "label": "Importer le corpus de CV (5054)", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/import_cvs.py --source ${input:cvSource} --sample-eval 60", "problemMatcher": [] },
    { "label": "Matching en lot (corpus)", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/batch_match.py", "problemMatcher": [] },
    { "label": "Ablation ML (B0/F1/A1)", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/run_ablation.py", "problemMatcher": [] },
    { "label": "Ablation LLM (L0/L1/A2)", "type": "shell",
      "command": "${command:python.interpreterPath} scripts/run_llm_ablation.py --no-cache", "problemMatcher": [] },
    { "label": "Tests", "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest", "group": "test", "problemMatcher": [] },
    { "label": "Docker up", "type": "shell",
      "command": "docker compose up --build", "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "cvSource", "type": "promptString",
      "description": "Dossier de CV ou fichier CSV/Parquet", "default": "data/raw/cvs" }
  ]
}
