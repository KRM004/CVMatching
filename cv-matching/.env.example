# --- Gemini (ne jamais committer la vraie clé) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_INTERVAL=1.0

# --- Service (un seul facteur change par ablation) ---
RANKER=sbert            # sbert | tfidf
CLEANING=on             # on | off
EXPLAINER=gemini        # gemini | rules
JOB_CONTEXT=on          # on | off  (A2 = off : Gemini sans description d'offre)
LANGUAGE=fr             # fr | en
SBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2   # "hashing" = encodeur factice hors-ligne

# --- Chemins (optionnels, relatifs à la racine) ---
# JOBS_PATH=data/processed/jobs_clean.parquet
# ARTIFACTS_DIR=artifacts
# CACHE_DIR=data/cache
# EVAL_DIR=data/eval
# RESULTS_DIR=results
